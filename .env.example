# --- PayPal sandbox (leave blank to run in demo mode) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your app. Enable "Vault" and "Payouts" under the app's features.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: the webhook ID from your app's Webhooks section, to verify webhook signatures
PAYPAL_WEBHOOK_ID=
# Optional: your sandbox business (merchant) account email, shown as the invoice sender
PAYPAL_MERCHANT_EMAIL=

# Sandbox personal accounts that receive payouts / invoices (developer.paypal.com > Sandbox accounts)
ALEX_SANDBOX_EMAIL=
MAYA_SANDBOX_EMAIL=

# Optional, for the hosted demo: pin an allowance you approved once, so the agent stays
# connected after restarts and visitors don't need a PayPal login. After connecting Alex in
# the app, both values are printed in the server log (they are never sent to the browser).
ALEX_VAULT_TOKEN=
ALEX_PAYER_ID=

# --- Claude (leave blank to run agents on built-in rules) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- App ---
# Public URL, used for PayPal return links (auto-detected if blank)
APP_URL=
# Secret for signing agent messages, agent credentials and receipts
SQUARE_SIGNING_SECRET=change-me
# Strongly recommended on any hosted copy connected to real sandbox keys: visitors must enter
# this code before they can see or approve anything. Share it only with people you trust.
SQUARE_ACCESS_CODE=
